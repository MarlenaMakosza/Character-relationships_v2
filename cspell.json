{
  "version": "0.2",
  "words": ["autofix"],
  "ignorePaths": ["package.json", "package-lock.json"],
  "useGitignore": true,
  "validateDirectives": true,
  "cache": {
    "useCache": true,
    "cacheLocation": "./node_modules/.cache/cspell/.cspell"
  },
  "language": "en",
  "dictionaries": ["html", "typescript", "css", "en-gb", "fonts", "npm", "custom-words"],
  "dictionaryDefinitions": [
    {
      "name": "custom-words",
      "path": "./.cspell/custom-words.txt",
      "addWords": true
    }
  ]
}
