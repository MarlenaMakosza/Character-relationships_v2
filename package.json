{
  "name": "charel",
  "version": "0.0.2",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "spellcheck": "cspell --no-progress --dot \"**/*.{js,ts,jsx,tsx,cjs,mjs,json,html,xml,svg,css,scss,sass,md}\"",
    "db:start": "docker compose up",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "autofix": "npm run lint:fix && npm run format",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "ts-check": "tsc",
    "commit": "cz",
    "validate": "npm run lint && npm run check && npm run ts-check && npm run test",
    "format": "prettier . --write --cache --log-level warn",
    "list-outdated-dependencies": "npm-check-updates --format repo,group --peer",
    "update-dependencies": "npm run list-outdated-dependencies -- -u && npm install && npm update && npm dedupe && npm run autofix",
    "clean": "rimraf node_modules coverage dist package-lock.json"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@cspell/eslint-plugin": "^9.8.0",
    "@eslint/js": "^9.18.0",
    "@eslint/json": "^1.2.0",
    "@eslint/markdown": "^8.0.1",
    "@faker-js/faker": "^10.4.0",
    "@html-eslint/eslint-plugin": "^0.58.1",
    "@html-eslint/parser": "^0.58.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.56.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testcontainers/postgresql": "^11.14.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/d3-graphviz": "^2.6.10",
    "@types/eslint": "^9.6.1",
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/node": "^25",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/eslint-plugin": "^1.6.14",
    "commitlint": "^20.5.0",
    "commitlint-plugin-function-rules": "^4.3.2",
    "cspell": "^9.8.0",
    "cz-conventional-changelog": "^3.3.0",
    "d3-graphviz": "^5.6.0",
    "dotenv": "^17.4.0",
    "dotenv-expand": "^12.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-eslint-plugin": "^7.3.2",
    "eslint-plugin-functional": "^9.0.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-alias": "^1.2.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-perfectionist": "^5.8.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-sonarjs": "^4.0.2",
    "eslint-plugin-svelte": "^3.17.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.4.0",
    "http-status-codes": "^2.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "npm-check-updates": "^20.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-svelte": "^3.5.1",
    "rimraf": "^6.1.3",
    "skott": "^0.35.9",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "svelte": "^5.55.1",
    "svelte-check": "^4.4.6",
    "svelte-eslint-parser": "^1.6.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.2",
    "zod": "^4.3.6"
  },
  "type": "module",
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.8"
  },
  "lint-staged": {
    "*.{ts,svelte}": [
      "eslint --fix",
      "prettier --write",
      "spellcheck"
    ],
    "*.css": [
      "prettier --write",
      "stylelint --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
